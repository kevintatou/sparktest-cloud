{
  "name": "sparktest-cloud",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:core": "pnpm --filter @tatou/core build", 
    "build:storage": "pnpm --filter @tatou/storage-service build",
    "build:ui": "pnpm --filter @tatou/ui build",
    "dev:frontend": "pnpm build:packages && pnpm --filter saas-frontend dev",
    "dev:backend": "cargo run --manifest-path apps/saas-backend/Cargo.toml",
    "build:frontend": "pnpm build:packages && pnpm --filter saas-frontend build",
    "build:backend": "cargo build --manifest-path apps/saas-backend/Cargo.toml",
    "lint:frontend": "pnpm --filter saas-frontend lint",
    "test:backend": "cargo test --manifest-path apps/saas-backend/Cargo.toml",
    "type-check": "pnpm --filter \"./packages/*\" type-check"
  },
  "devDependencies": {
    "@types/node": "^20"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.83.0",
    "lucide-react": "^0.526.0",
    "react-hook-form": "^7.61.1",
    "zod": "^4.0.10",
    "zustand": "^5.0.6"
  }
}
