{
  "name": "sparktest-cloud-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SparkTest SaaS monorepo",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:apps && cargo build",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:apps": "pnpm --filter './apps/*' build",
    "build:saas-frontend": "pnpm --filter '@tatou/sparktest-saas-frontend' build",
    "dev": "pnpm --filter '@tatou/sparktest-saas-frontend' dev",
    "dev:frontend": "pnpm --filter '@tatou/sparktest-saas-frontend' dev",
    "dev:backend": "cargo run -p sparktest-saas-bin --manifest-path apps/saas/backend/bin/Cargo.toml",
    "dev:all": "concurrently -k -n backend,frontend -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "test": "pnpm build:packages && pnpm --filter './apps/*' test",
    "lint": "pnpm --filter './packages/*' lint && pnpm --filter './apps/*' lint",
    "type-check": "pnpm --filter './packages/*' type-check && pnpm --filter './apps/*' type-check",
    "clean": "pnpm --filter './packages/*' clean",
    "cargo-build": "cargo build",
    "cargo-test": "cargo test",
    "cargo-run": "cargo run -p sparktest-saas-bin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:all": "pnpm lint && pnpm format:check",
    "fix": "pnpm format && pnpm lint",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "deploy:droplet": "./scripts/deploy-droplet.sh"
  },
  "workspaces": [
    "apps/*",
    "apps/saas/*", 
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^7.6.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}