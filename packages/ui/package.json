{
  "name": "@tatou/sparktest-ui",
  "version": "1.2.2",
  "description": "UI components for SparkTest",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tatou/sparktest-core": "workspace:*",
    "lucide-react": "^0.454.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5"
  }
}