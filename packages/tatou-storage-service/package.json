{
  "name": "@tatou/storage-service",
  "version": "0.2.0",
  "description": "Storage service utilities for SparkTest",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tatou/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}